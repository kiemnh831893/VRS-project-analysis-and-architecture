# Staging API configuration for running the API outside Docker.
# For the compose-based deployment, use the root .env.staging.example instead.
# Copy to apps/api/.env.staging and replace every placeholder. NEVER commit it.

NODE_ENV=staging
PORT=4000
CORS_ORIGIN=https://staging.example.edu
DATABASE_URL="postgresql://vrs_staging:replace_with_a_generated_postgres_password@localhost:5432/vrs_staging?schema=public"
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
