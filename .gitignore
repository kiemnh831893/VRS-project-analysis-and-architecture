apps/api/src/generated/
apps/api/prisma/generated/

# Prisma CLI helper files (optional agent skills)
.agents/
.claude/
.windsurf/
skills-lock.json

# Editors and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local uploads (license images, contracts)
storage/

# Database backup artifacts (may contain personal data)
backups/
