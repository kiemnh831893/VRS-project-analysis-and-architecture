# Staging configuration for docker-compose.staging.yml.
# Copy to .env.staging on the staging host and replace every placeholder.
# NEVER commit .env.staging. It is ignored by .gitignore.

# PostgreSQL (used by the db service).
POSTGRES_USER=vrs_staging
POSTGRES_PASSWORD=replace_with_a_generated_postgres_password
POSTGRES_DB=vrs_staging

# API database URL. The host must be `db` (the compose service name).
# URL-encode special characters in the password.
DATABASE_URL=postgresql://vrs_staging:replace_with_a_generated_postgres_password@db:5432/vrs_staging?schema=public

# Browser origin allowed by CORS. Use the real staging HTTPS origin.
CORS_ORIGIN=https://staging.example.edu

# Generate a random value of at least 32 characters, e.g. with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d

# Optional local bind ports for staging smoke checks.
STAGING_API_PORT=4001
STAGING_WEB_PORT=4173

# Rate limiting (per IP, per window).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
